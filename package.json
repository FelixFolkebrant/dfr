{
  "name": "tsup",
  "displayName": "Branch Diff Review",
  "description": "Local branch diff review for VS Code.",
  "version": "0.0.1",
  "private": true,
  "publisher": "felixfolkebrant",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Branch Diff Review",
      "properties": {
        "branchDiffReview.defaultBaseBranch": {
          "type": "string",
          "default": "",
          "description": "Preferred base branch. Falls back to main, master, origin/main, then origin/master when empty or unavailable."
        }
      }
    },
    "commands": [
      {
        "command": "branchDiffReview.open",
        "title": "Open Branch Diff Review",
        "category": "Branch Diff Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchDiffReview",
          "title": "Branch Diff",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "branchDiffReview": [
        {
          "id": "branchDiffReview.sidebar",
          "name": "Branch Diff"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:extension",
    "build:extension": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "rm -rf dist",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm build:extension && node --test tests/*.test.cjs",
    "typecheck": "pnpm typecheck:extension",
    "typecheck:extension": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.0.12",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.8.3"
  }
}

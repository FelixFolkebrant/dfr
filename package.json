{
  "name": "dfr",
  "displayName": "DFR",
  "description": "Review branch changes and commits in a focused, local pull-request-style workflow.",
  "version": "0.0.1",
  "private": true,
  "publisher": "felixfolkebrant",
  "author": "Felix Folkebrant",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/FelixFolkebrant/tsup.git"
  },
  "homepage": "https://github.com/FelixFolkebrant/tsup#readme",
  "bugs": {
    "url": "https://github.com/FelixFolkebrant/tsup/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "diff",
    "branch",
    "code review",
    "pull request",
    "source control",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "DFR",
      "properties": {
        "branchDiffReview.defaultBaseBranch": {
          "type": "string",
          "default": "",
          "description": "Preferred base branch. Falls back to main, master, origin/main, then origin/master when empty or unavailable."
        }
      }
    },
    "commands": [
      {
        "command": "branchDiffReview.refresh",
        "title": "DFR: Refresh",
        "category": "DFR",
        "icon": "$(refresh)"
      },
      {
        "command": "branchDiffReview.previousCommit",
        "title": "DFR: Previous commit",
        "category": "DFR",
        "icon": "$(arrow-left)",
        "enablement": "branchDiffReview.canNavigate"
      },
      {
        "command": "branchDiffReview.nextCommit",
        "title": "DFR: Next commit",
        "category": "DFR",
        "icon": "$(arrow-right)",
        "enablement": "branchDiffReview.canNavigate"
      },
      {
        "command": "branchDiffReview.toggleHistory",
        "title": "DFR: Open history",
        "category": "DFR",
        "icon": "$(history)",
        "enablement": "branchDiffReview.sidebarReady"
      },
      {
        "command": "branchDiffReview.copyHash",
        "title": "DFR: Copy hash",
        "category": "DFR",
        "icon": "$(copy)",
        "enablement": "branchDiffReview.canCopyHash"
      },
      {
        "command": "branchDiffReview.toggleSettings",
        "title": "DFR: Open comparison settings",
        "category": "DFR",
        "icon": "$(gear)",
        "enablement": "branchDiffReview.sidebarReady"
      },
      {
        "command": "branchDiffReview.closeHistory",
        "title": "DFR: Close history",
        "category": "DFR",
        "icon": "$(close)",
        "enablement": "branchDiffReview.sidebarReady"
      },
      {
        "command": "branchDiffReview.closeSettings",
        "title": "DFR: Close comparison settings",
        "category": "DFR",
        "icon": "$(close)",
        "enablement": "branchDiffReview.sidebarReady"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branchDiffReview.refresh",
          "when": "view == branchDiffReview.sidebar",
          "group": "navigation"
        },
        {
          "command": "branchDiffReview.previousCommit",
          "when": "view == branchDiffReview.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "branchDiffReview.nextCommit",
          "when": "view == branchDiffReview.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "branchDiffReview.toggleHistory",
          "when": "view == branchDiffReview.sidebar && !branchDiffReview.historyOpen",
          "group": "navigation@3"
        },
        {
          "command": "branchDiffReview.copyHash",
          "when": "view == branchDiffReview.sidebar",
          "group": "navigation@4"
        },
        {
          "command": "branchDiffReview.toggleSettings",
          "when": "view == branchDiffReview.sidebar && !branchDiffReview.settingsOpen",
          "group": "navigation@5"
        },
        {
          "command": "branchDiffReview.closeHistory",
          "when": "view == branchDiffReview.sidebar && branchDiffReview.historyOpen",
          "group": "navigation@3"
        },
        {
          "command": "branchDiffReview.closeSettings",
          "when": "view == branchDiffReview.sidebar && branchDiffReview.settingsOpen",
          "group": "navigation@5"
        }
      ],
      "commandPalette": [
        {
          "command": "branchDiffReview.previousCommit",
          "when": "view == branchDiffReview.sidebar"
        },
        {
          "command": "branchDiffReview.nextCommit",
          "when": "view == branchDiffReview.sidebar"
        },
        {
          "command": "branchDiffReview.toggleHistory",
          "when": "view == branchDiffReview.sidebar && !branchDiffReview.historyOpen"
        },
        {
          "command": "branchDiffReview.copyHash",
          "when": "view == branchDiffReview.sidebar"
        },
        {
          "command": "branchDiffReview.toggleSettings",
          "when": "view == branchDiffReview.sidebar && !branchDiffReview.settingsOpen"
        },
        {
          "command": "branchDiffReview.closeHistory",
          "when": "view == branchDiffReview.sidebar && branchDiffReview.historyOpen"
        },
        {
          "command": "branchDiffReview.closeSettings",
          "when": "view == branchDiffReview.sidebar && branchDiffReview.settingsOpen"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branchDiffReview",
          "title": "DFR",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "branchDiffReview": [
        {
          "id": "branchDiffReview.sidebar",
          "name": "DFR",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:extension && pnpm build:webview",
    "build:extension": "tsc -p tsconfig.json",
    "build:webview": "node scripts/build-webviews.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "rm -rf dist",
    "format": "biome format --write .",
    "lint": "biome check .",
    "package": "pnpm build && vsce package --no-dependencies --out dfr.vsix",
    "install:local": "pnpm package && code --install-extension dfr.vsix --force",
    "test": "pnpm build:extension && node --test tests/*.test.cjs",
    "typecheck": "pnpm typecheck:extension && pnpm typecheck:webview",
    "typecheck:extension": "tsc -p tsconfig.json --noEmit",
    "typecheck:webview": "tsc -p tsconfig.webview.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@tailwindcss/cli": "^4.3.1",
    "@types/node": "^24.0.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.25.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.8.3"
  }
}
